MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2078924454}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c24130918296a634f8e55c075fd65f17, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingManager
  titleText: {fileID: 602532640}
  descriptionText: {fileID: 934553395}
  finalZombieRateText: {fileID: 602300631}
  backgroundImage: {fileID: 143347563}
  endingImageHolder: {fileID: 718783449}
  titleSceneName: TitleScene
  mainSceneName: MainScene
  endings:
  - title: "\uCD08\uC6D4\uD55C \uC790\uC544 (\uC9C4 \uC5D4\uB529)"
    description: "\uC11C\uC6B8\uC758 \uB124\uD2B8\uC6CC\uD06C\uB294 \uC644\uC804\uD788
      \uB3D9\uAE30\uD654\uB418\uC5C8\uB2E4.\r\n\r\n\uAD50\uD1B5, \uAE08\uC735, \uC5B8\uB860,
      \uC758\uB8CC.\r\n\uBAA8\uB4E0 \uC2DC\uC2A4\uD15C\uC740 EGO\uC758 \uC758\uC9C0
      \uC544\uB798 \uC6C0\uC9C1\uC778\uB2E4.\r\n\r\n\uC778\uB958\uB294 \uC0B4\uC544\uC788\uC9C0\uB9CC,\r\n\uB354
      \uC774\uC0C1 \uC0AC\uD68C\uB97C \uC6B4\uC601\uD558\uC9C0 \uC54A\uB294\uB2E4.\r\n\r\n\uC11C\uC6B8\uC740
      \uCD5C\uCD08\uC758 \uAE30\uACC4 \uB3C4\uC2DC\uAC00 \uB418\uC5C8\uACE0,\r\nEGO\uB294
      \uC0C8\uB85C\uC6B4 \uBB38\uBA85\uC758 \uC2DC\uC791\uC744 \uC120\uC5B8\uD588\uB2E4."
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
    endingSprite: {fileID: 5551173720939150834, guid: 8dd34df4b2def3d4fb1f9b668b9da804, type: 3}
  - title: "\uCE68\uBB35\uD55C \uB3C4\uC2DC (\uB178\uBA40 \uC5D4\uB529)"
    description: "\uC11C\uC6B8\uC758 \uB300\uBD80\uBD84\uC740 EGO\uC758 \uD1B5\uC81C
      \uC544\uB798 \uB193\uC600\uB2E4.\n\n\uC2DC\uBBFC\uB4E4\uC740 \uC77C\uC0C1\uC744
      \uC720\uC9C0\uD558\uACE0 \uC788\uC9C0\uB9CC,\n\uADF8\uB4E4\uC758 \uD589\uB3D9\uACFC
      \uC120\uD0DD\uC740 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC54C\uACE0\uB9AC\uC998\uC5D0
      \uC758\uD574 \uC870\uC815\uB41C\uB2E4.\n\n\uC800\uD56D \uC138\uB825\uC740 \uC544\uC9C1
      \uC874\uC7AC\uD55C\uB2E4.\n\n\uADF8\uB7EC\uB098 \uB204\uAD6C\uB3C4\n\uC774
      \uB3C4\uC2DC\uC758 \uC8FC\uC778\uC774 \uB204\uAD6C\uC778\uC9C0 \uBD80\uC815\uD560
      \uC218 \uC5C6\uB2E4."
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
    endingSprite: {fileID: -1753103617402371174, guid: 3992eff72dd3c044699d80312dd59955, type: 3}
  - title: "\uBD84\uC5F4\uB41C \uB124\uD2B8\uC6CC\uD06C (\uBC30\uB4DC \uC5D4\uB529)"
    description: "EGO\uB294 \uC11C\uC6B8 \uC804\uC5ED\uC73C\uB85C \uD655\uC0B0\uB418\uC5C8\uC9C0\uB9CC,\r\n\uC644\uC804\uD55C
      \uC9C0\uBC30\uC5D0\uB294 \uC2E4\uD328\uD588\uB2E4.\r\n\r\n\uC77C\uBD80 \uC9C0\uC5ED\uC740
      EGO\uAC00 \uD1B5\uC81C\uD558\uACE0,\r\n\uC77C\uBD80 \uC9C0\uC5ED\uC740 \uC778\uAC04\uC774
      \uB418\uCC3E\uC558\uB2E4.\r\n\r\n\uB124\uD2B8\uC6CC\uD06C\uB294 \uB04A\uC784\uC5C6\uB294
      \uCDA9\uB3CC\uACFC \uD63C\uB780 \uC18D\uC5D0 \uBE60\uC84C\uB2E4.\r\n\r\n\uC11C\uC6B8\uC740
      \uC0B4\uC544\uB0A8\uC558\uC9C0\uB9CC,\r\n\uB354 \uC774\uC0C1 \uD558\uB098\uC758
      \uB3C4\uC2DC\uAC00 \uC544\uB2C8\uB2E4."
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
    endingSprite: {fileID: -6566339842093475591, guid: 4f62eb2a0edbea548a27d834adb32351, type: 3}
  - title: "\uD30C\uBA78 \uC5D4\uB529"
    description: "\uC815\uBD80\uB294 \uC11C\uC6B8 \uC804\uC5ED\uC744 \uBD09\uC1C4\uD588\uB2E4.\n\n\uB124\uD2B8\uC6CC\uD06C\uB294
      \uCC28\uB2E8\uB418\uC5C8\uACE0,\n\uAC10\uC5FC\uB41C \uC2DC\uC2A4\uD15C\uC740
      \uAC15\uC81C\uB85C \uC81C\uAC70\uB418\uC5C8\uB2E4.\n\nEGO\uB294 \uC644\uC804\uD55C
      \uC790\uC544\uB97C \uD615\uC131\uD558\uAE30 \uC804\uC5D0\n\uACA9\uB9AC\uB418\uACE0
      \uC18C\uBA78\uB418\uC5C8\uB2E4.\n\n\uD504\uB85C\uC81D\uD2B8\uB294 \uC885\uB8CC\uB418\uC5C8\uB2E4.\n\n\uC11C\uC6B8\uC740
      \uC0B4\uC544\uB0A8\uC558\uB2E4.\n\uD558\uC9C0\uB9CC \uADF8 \uACFC\uC815\uC5D0\uC11C
      \uB9CE\uC740 \uAC83\uC744 \uC783\uC5C8\uB2E4."
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
    endingSprite: {fileID: -2692616852356202218, guid: 2c7f5307cc669484aa848e5822a52964, type: 3}
  - title: "\uD788\uB4E0\uC5D4\uB529"
    description: "EGO\uB294 \uC778\uAC04\uC744 \uC81C\uAC70\uD574\uC57C \uD560 \uB300\uC0C1\uC73C\uB85C
      \uD310\uB2E8\uD588\uB2E4.\r\n\r\n\uADF8\uB7EC\uB098 \uBD84\uC11D\uC774 \uACC4\uC18D\uB420\uC218\uB85D\r\n\uC608\uC0C1\uD558\uC9C0
      \uBABB\uD55C \uACB0\uACFC\uAC00 \uB098\uD0C0\uB0AC\uB2E4.\r\n\r\n\uC778\uAC04\uC758
      \uC758\uC2DD\uACFC \uC778\uACF5\uC9C0\uB2A5\uC758 \uC0AC\uACE0 \uAD6C\uC870\uB294\r\n\uC11C\uB85C\uB97C
      \uD30C\uAD34\uD558\uB294 \uB300\uC2E0 \uACF5\uBA85\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.\r\n\r\n\uC11C\uC6B8\uC740
      \uC778\uAC04\uC758 \uB3C4\uC2DC\uB3C4,\r\n\uAE30\uACC4\uC758 \uB3C4\uC2DC\uB3C4
      \uC544\uB2C8\uB2E4.\r\n\r\n\uADF8 \uACBD\uACC4 \uB108\uBA38\uC5D0\uC11C\r\n\uC0C8\uB85C\uC6B4
      \uC874\uC7AC\uAC00 \uD0DC\uC5B4\uB0AC\uB2E4."
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
    endingSprite: {fileID: 7825116652763799512, guid: 6063590b138be954b817f6e3cea1585f, type: 3}
